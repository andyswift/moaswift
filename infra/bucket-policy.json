{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFrontReadObjects",
      "Effect": "Allow",
      "Principal": { "Service": "cloudfront.amazonaws.com" },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::moaswift/*",
      "Condition": { "StringEquals": { "AWS:SourceArn": "arn:aws:cloudfront::<ACCOUNT_ID>:distribution/E1MUDCSWW05U01" } }
    },
    {
      "Sid": "CloudFrontListForProper404s",
      "Effect": "Allow",
      "Principal": { "Service": "cloudfront.amazonaws.com" },
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::moaswift",
      "Condition": { "StringEquals": { "AWS:SourceArn": "arn:aws:cloudfront::<ACCOUNT_ID>:distribution/E1MUDCSWW05U01" } }
    }
  ]
}
